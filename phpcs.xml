<?xml version="1.0"?>
<ruleset name="">
    <description><!-- description --></description>

    <!-- Display progress and enable colors -->
    <arg value="p"/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>

    <!-- Target Directories -->
    <file>bin</file>
    <file>src</file>
    <file>tests</file>

    <!-- PSR-12 Base Standard -->
    <rule ref="PSR12">
        <!-- 8fold prefers one empty line before the closing of most control structures -->
        <exclude name="Squiz.WhiteSpace.ControlStructureSpacing.SpacingBeforeClose"/>
        <!-- 8fold separates `use` clauses, all other PSR12 whitespace rules should apply -->
        <exclude name="PSR12.Files.FileHeader"/>
    </rule>

    <!-- snake_case test method names -->
    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>

    <!-- Exclusions -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
</ruleset>
