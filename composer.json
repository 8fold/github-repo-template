{
  "name": "vendor/project",
  "description": "",
  "type": "library",
  "license": "proprietary",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "authors": [
    {
      "name": "Josh Bruce",
      "email": "josh@8fold.pro",
      "homepage": "https://joshbruce.com",
      "role": "Lead Developer"
    }
  ],
  "support": {
  },
  "repositories": [],
  "require": {
    "php": "^8.5"
  },
  "require-dev": {
    "symfony/process": "^8.1",

    "squizlabs/php_codesniffer": "^4.0",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2",

    "phpstan/phpstan": "^2.3",
    "phpstan/phpstan-strict-rules": "^2.1",
    "spaze/phpstan-disallowed-calls": "^4.15",
    "phpstan/extension-installer": "*",

    "phpunit/phpunit": "^13.4"

  },
  "autoload": {
    "psr-4": {
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Eightfold\\Package\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "prod": "@production",
    "production": [
      "@autoload:prod",
      "@check"
    ],

    "local": [
      "@autoload:local",
      "@check"
    ],

    "check": [
      "@check:dependencies",
      "@check:tabs",
      "@check:style",
      "@check:analysis",
      "@check:test"
    ],
    "check:dependencies": "composer validate --no-check-publish",
    "check:tabs": "php ./bin/check-tabs.php",
    "check:style": "./vendor/bin/phpcs --standard=phpcs.xml",
    "check:analysis": "./vendor/bin/phpstan analyze",
    "check:test": "./vendor/bin/phpunit --display-all-issues",

    "autoload:prod": "composer dumpautoload --no-dev --classmap-authoritative",
    "autoload:local": "composer dumpautoload -o"
  },
  "extra": {
    "phpstan/extension-installer": {
      "ignore": [
        "spaze/phpstan-disallowed-calls"
      ]
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    },
    "sort-packages": true
  }
}
